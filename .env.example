# ---------------------------------------------------------------------------
# Backend configuration. Copy to .env and fill in real values.
# Never commit .env - it is in .gitignore.
# ---------------------------------------------------------------------------

# Comma-separated key pool (at least 2). Key ids are key_1, key_2, ... in this order.
# Tip: create the keys in two different Groq accounts - Groq rate limits are per account.
LLM_API_KEYS=gsk_your_first_key_here,gsk_your_second_key_here

# LiteLLM model name used by every key (provider/model).
LLM_MODEL=groq/openai/gpt-oss-120b

# Optional: one model per key, same order as LLM_API_KEYS (falls back to LLM_MODEL).
# Example mixing models: LLM_MODELS=groq/openai/gpt-oss-120b,groq/openai/gpt-oss-20b
LLM_MODELS=

# SQLite location. In Docker this is always sqlite:////data/app.db (the named volume).
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins allowed to call the API (your frontend URL).
ALLOWED_ORIGINS=http://localhost:3000

# true enables the X-Simulate-Failure test hook (must be true on the deployed backend).
ENABLE_FAILURE_SIMULATION=true

# ---- optional tuning -------------------------------------------------------
# DEFAULT_SYSTEM_PROMPT=You are a helpful, friendly assistant.
CACHE_TTL_SECONDS=3600
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=2048
# low | medium | high (reasoning models such as gpt-oss); "none" to not send it
LLM_REASONING_EFFORT=low
# LLM_TEMPERATURE=0.7
# How many earlier messages of a session are sent to the model as context.
MAX_HISTORY_MESSAGES=40
# Point LiteLLM at a different OpenAI-compatible base URL (used by the tests). Leave empty.
LLM_API_BASE=
# Exposes /docs and /openapi.json. Off by default so only the 3 contract endpoints exist.
ENABLE_API_DOCS=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend configuration
# ---------------------------------------------------------------------------
# Docker: backend URL as seen from the browser (written into /config.js at container start).
FRONTEND_API_BASE_URL=http://localhost:8000
# Static hosting (Render / Vercel / Netlify): set this at build time instead.
VITE_API_BASE_URL=http://localhost:8000
